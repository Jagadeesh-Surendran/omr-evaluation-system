    {
      "name": "Evaluate Batch (Parallel)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "omr_files",
              "type": "file",
              "src": [],
              "description": "Multiple OMR sheet images"
