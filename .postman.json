    {
      "name": "AI Solver - Update Answer",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answer\": \"C\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/solve/session/{{session_id}}/answer/1",
          "host": ["{{base_url}}"],
          "path": ["api", "solve", "session", "{{session_id}}", "answer", "1"]
        },
        "description": "Manually correct an AI-generated answer"
      },
      "response": []
    },
    {
      "name": "AI Solver - Add Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"This question needs review\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/solve/session/{{session_id}}/note/1",
          "host": ["{{base_url}}"],
          "path": ["api", "solve", "session", "{{session_id}}", "note", "1"]
