    {
      "name": "Link Student Database",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "db_file",
              "type": "file",
              "src": [],
              "description": "CSV file with student names (Roll Number, Name)"
            },
            {
              "key": "current_results",
              "value": "[]",
              "type": "text",
              "description": "JSON array of current evaluation results"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/link_db",
          "host": ["{{base_url}}"],
          "path": ["api", "link_db"]
        },
        "description": "Map student names from CSV to results by row position"
      },
      "response": []
    },
    {
      "name": "Export Results (CSV)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"results\": [\n    {\n      \"id\": \"CAND-1001\",\n      \"name\": \"Student 1\",\n      \"score\": 85.5,\n      \"filename\": \"sheet1.jpg\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/export?format=csv",
          "host": ["{{base_url}}"],
          "path": ["api", "export"],
          "query": [
            {
              "key": "format",
              "value": "csv",
              "description": "Export format: csv or excel"
            }
          ]
        },
        "description": "Export evaluation results as CSV file"
      },
      "response": []
    },
    {
      "name": "Export Results (Excel)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"results\": [\n    {\n      \"id\": \"CAND-1001\",\n      \"name\": \"Student 1\",\n      \"score\": 85.5,\n      \"filename\": \"sheet1.jpg\",\n      \"question_details\": []\n    }\n  ]\n}"
