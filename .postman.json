    {
      "name": "AI Solver - Upload PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "qp_file",
              "type": "file",
              "src": [],
              "description": "Question bank PDF file"
