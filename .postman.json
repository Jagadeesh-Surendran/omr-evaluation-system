      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/solve/session/{{session_id}}/cancel",
          "host": ["{{base_url}}"],
          "path": ["api", "solve", "session", "{{session_id}}", "cancel"]
