{
  "info": {
    "name": "OMR Evaluation System API",
    "description": "EvalGenius AI - Next-generation Optical Mark Recognition system with AI-powered answer key extraction",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        },
        "description": "Check if the API server is running"
      },
      "response": []
    },
    {
      "name": "Extract Answer Key (AI)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "qp_file",
              "type": "file",
              "src": [],
              "description": "Question paper image or PDF file"
            },
            {
              "key": "expected_count",
              "value": "100",
              "type": "text",
              "description": "Optional: Expected number of questions for validation"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/extract_key",
          "host": ["{{base_url}}"],
          "path": ["api", "extract_key"]
        },
        "description": "Extract answer key from question paper using AI (Ollama moondream model)"
      },
      "response": []
    },
    {
      "name": "Evaluate OMR Sheets (Batch)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "omr_files",
              "type": "file",
              "src": [],
              "description": "Multiple OMR sheet images"
            },
            {
              "key": "answer_key_json",
              "value": "{\"0\":0,\"1\":2,\"2\":1}",
              "type": "text",
              "description": "Answer key in JSON format (0-based indices)"
            },
            {
              "key": "num_options",
              "value": "5",
              "type": "text",
              "description": "Number of options per question (3, 4, or 5)"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/evaluate",
          "host": ["{{base_url}}"],
          "path": ["api", "evaluate"]
        },
        "description": "Evaluate multiple OMR sheets with answer key"
      },
      "response": []
    },
    {
      "name": "Evaluate OMR Sheets (Multiplex)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "omr_files",
              "type": "file",
              "src": [],
              "description": "Multiple OMR sheet images"
            },
            {
              "key": "answer_keys_multiplex",
              "value": "{\"A\":{\"0\":0,\"1\":2},\"B\":{\"0\":1,\"1\":3}}",
              "type": "text",
              "description": "Multiple answer keys for different sets (A, B)"
            },
            {
              "key": "num_options",
              "value": "5",
              "type": "text",
              "description": "Number of options per question"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/evaluate",
          "host": ["{{base_url}}"],
          "path": ["api", "evaluate"]
        },
        "description": "Evaluate OMR sheets with multiple answer keys (Set A, Set B)"
      },
      "response": []
    },
